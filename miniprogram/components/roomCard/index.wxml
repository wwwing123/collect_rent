<view class="card">
  <view class="head">
    <view class="head-left">
      <view class="code">{{ room.code }}</view>
      <view class="meta">
        <view class="meta-top">
          <text wx:if="{{ room.name }}" class="name">{{ room.name }}</text>
          <view wx:if="{{ room.status === 'active' && hasBill }}" class="tag tag-done">
            <text>已出账</text>
          </view>
          <view wx:elif="{{ room.status === 'active' }}" class="tag tag-pending">
            <text>待出账</text>
          </view>
          <view wx:else class="tag tag-off">
            <text>已空</text>
          </view>
        </view>
        <view class="meta-bottom">
          <block wx:if="{{ hasBill }}">
            <text class="amount-label">{{ billLabel }} 应收</text>
            <text class="amount-num tabular">¥{{ billTotal }}</text>
            <text class="amount-unit">/月</text>
          </block>
          <block wx:else>
            <text class="amount-empty">{{ billLabel }} 尚未生成</text>
          </block>
        </view>
      </view>
    </view>
    <view class="head-settings" bindtap="onSettings" hover-class="press">
      <text class="head-settings-glyph">⚙</text>
      <text class="head-settings-label">设置</text>
    </view>
  </view>

  <view class="actions">
    <view class="action-btn primary {{ !isActive ? 'disabled' : '' }}" bindtap="onGenerate" hover-class="press">
      <text class="action-label">生成账单</text>
    </view>
    <view class="action-btn ghost" bindtap="onHistory" hover-class="press">
      <text class="action-label">历史账单</text>
    </view>
    <view class="action-btn ghost {{ !hasBill ? 'disabled' : '' }}" bindtap="onReceipt" hover-class="press">
      <text class="action-label">收据</text>
    </view>
  </view>
</view>
