.card {
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  background: #fff;
  margin-bottom: 24rpx;
}
.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.name { color: #888; font-weight: 400; font-size: 28rpx; }
.settings-btn {
  font-size: 32rpx;
  padding: 4rpx 8rpx;
  margin-left: 8rpx;
  opacity: 0.55;
}
.amount {
  font-size: 24rpx;
  color: #888;
  text-align: right;
}
.num {
  color: #e54545;
  font-weight: 600;
}
.empty { color: #aaa; }
.actions {
  display: flex;
  gap: 12rpx;
}
.action-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 8rpx;
  background: #fff;
  border: 2rpx solid #e5e5e5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-btn.primary {
  background: #07c160;
  border-color: #07c160;
  color: #fff;
}
.action-btn.disabled {
  opacity: 0.5;
}
.action-btn:active {
  opacity: 0.7;
}
.btn-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.btn-icon { font-size: 26rpx; line-height: 1; }
.btn-label { font-size: 24rpx; line-height: 1; }
