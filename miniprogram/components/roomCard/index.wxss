.card {
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: var(--s-3);
  box-shadow: var(--shadow-sm);
  /* 注意：不要在 .card 上加 transform 动画，会阻断子元素 tap */
}

/* —— 头部 —— */
.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--s-2);
  margin-bottom: var(--s-3);
}
.head-left {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: var(--s-3);
  min-width: 0;
}

/* 房号：宋体大号、墨色 */
.code {
  font-family: var(--font-serif);
  font-size: 48rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.04em;
  line-height: 1;
  flex: 0 0 auto;
  padding-top: 4rpx;
}

.meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.meta-top {
  display: flex;
  align-items: center;
  gap: var(--s-1);
  flex-wrap: wrap;
}
.name {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--ink);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 3rpx 12rpx;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  letter-spacing: 0.04em;
}
.tag-done   { background: var(--jade-soft);    color: var(--jade); }
.tag-pending{ background: var(--amber-soft);   color: var(--amber-2); }
.tag-off    { background: var(--paper-3);      color: var(--ink-3); }

.meta-bottom {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 2rpx;
  flex-wrap: wrap;
}
.amount-label {
  font-size: var(--fs-xs);
  color: var(--ink-3);
  letter-spacing: 0.04em;
}
.amount-num {
  font-family: var(--font-num);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--amber);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.01em;
}
.amount-unit {
  font-size: var(--fs-xs);
  color: var(--ink-3);
}
.amount-empty {
  font-size: var(--fs-xs);
  color: var(--ink-4);
  letter-spacing: 0.04em;
}

/* 右上角「设置」小药丸 */
.head-settings {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
  background: var(--paper-3);
  color: var(--ink-2);
  margin-top: 4rpx;
}
.head-settings.press { background: var(--paper-4); opacity: 0.85; }
.head-settings-glyph {
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1;
}
.head-settings-label {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--ink-2);
}

/* —— 动作按钮组 —— */
.actions {
  display: flex;
  gap: var(--s-1);
}
.action-btn {
  flex: 1;
  height: 64rpx;
  border-radius: var(--r-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  /* 不用 transform 改用 box-shadow 做按压反馈，避免影响子事件 */
  transition: background 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
}
.action-btn.press { opacity: 0.78; }
.action-btn.ghost {
  background: var(--paper-3);
  color: var(--ink-2);
}
.action-btn.ghost.press { background: var(--paper-4); }
.action-btn.primary {
  background: var(--amber);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(234, 123, 58, 0.20);
}
.action-btn.primary.press {
  background: var(--amber-2);
  box-shadow: 0 1rpx 4rpx rgba(234, 123, 58, 0.20);
}
.action-btn.disabled {
  opacity: 0.4;
}
.action-label {
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: inherit;
}
