.card {
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 24rpx;
  background: #fff;
  margin-bottom: 24rpx;
}
.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
}
.name { color: #888; font-weight: 400; font-size: 28rpx; }
.amount {
  font-size: 24rpx;
  color: #888;
  text-align: right;
}
.num {
  color: #e54545;
  font-weight: 600;
}
.empty { color: #aaa; }
.actions {
  display: flex;
  gap: 16rpx;
}
.actions van-button { flex: 1; }
