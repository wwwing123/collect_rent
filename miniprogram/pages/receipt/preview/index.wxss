.container {
  min-height: 100vh;
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.loading {
  margin-top: 200rpx;
  color: #888;
  font-size: 28rpx;
}

.canvas-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 48rpx;
}

.receipt-canvas {
  width: 670rpx;
  height: 417rpx;
  background: #fadade;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.share-btn {
  background: #fff;
  color: #07c160;
  border: 2rpx solid #07c160;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  height: 80rpx;
  padding: 0;
}
