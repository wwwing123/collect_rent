<view class="container">
  <view wx:if="{{ loading }}" class="loading">加载中...</view>

  <view wx:else class="canvas-wrap">
    <canvas type="2d" id="receipt-canvas" class="receipt-canvas"></canvas>
  </view>

  <view class="actions" wx:if="{{ !loading }}">
    <van-button type="primary" block bind:click="onSave">保存到相册</van-button>
    <button class="share-btn" open-type="share">发送给朋友</button>
  </view>
</view>
