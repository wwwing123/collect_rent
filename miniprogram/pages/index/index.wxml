<view class="container">
  <!-- 问候 + 总览 -->
  <view class="greeting">
    <view class="greeting-left">
      <text class="greeting-hello">本月账本</text>
      <view class="greeting-summary">
        <text class="summary-text">共 {{ rooms.length }} 间房 · 本月应收</text>
        <text class="summary-num tabular">¥{{ sumTotal }}</text>
      </view>
    </view>
    <view wx:if="{{ isAdmin }}" class="greeting-actions">
      <view class="settings-link" bindtap="onSync" hover-class="press">
        <text class="settings-link-glyph">↻</text>
      </view>
      <view class="settings-link" bindtap="onHeaderSettings" hover-class="press">
        <text class="settings-link-glyph">⚙</text>
      </view>
    </view>
  </view>

  <!-- 月份选择 -->
  <view class="month-bar">
    <view class="month-arrow {{ canPrev ? '' : 'disabled' }}" bindtap="onPrevMonth" hover-class="{{ canPrev ? 'press' : 'none' }}">
      <text class="arrow-glyph">‹</text>
    </view>
    <picker mode="date" fields="month" value="{{ currentYM }}" start="{{ minYearMonth }}" end="{{ maxYearMonth }}" bindchange="onPickMonth">
      <view class="month-display" hover-class="press">
        <text class="month-name">{{ currentYM }}</text>
        <text class="month-hint">▾</text>
      </view>
    </picker>
    <view class="month-arrow {{ canNext ? '' : 'disabled' }}" bindtap="onNextMonth" hover-class="{{ canNext ? 'press' : 'none' }}">
      <text class="arrow-glyph">›</text>
    </view>
  </view>

  <!-- 房间列表 -->
  <view wx:if="{{ loading }}" class="loading-box">
    <view class="loading-dots">
      <view class="dot dot-1"></view>
      <view class="dot dot-2"></view>
      <view class="dot dot-3"></view>
    </view>
    <text class="loading-text">{{ currentYM }} 账本展开中...</text>
  </view>

  <view wx:else class="cards">
    <room-card
      wx:for="{{ rooms }}"
      wx:key="_id"
      room="{{ item.room }}"
      bill-total="{{ item.billTotal }}"
      has-bill="{{ item.hasBill }}"
      bill-label="{{ item.billLabel }}"
      is-active="{{ item.room.status === 'active' }}"
      bind:settings="onSettings"
      bind:generate="onGenerate"
      bind:history="onHistory"
      bind:receipt="onReceipt"
    />
  </view>
</view>
