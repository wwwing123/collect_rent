.container {
  padding: var(--s-4) var(--s-3) var(--s-6);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
}

/* —— 问候区 —— */
.greeting {
  padding: var(--s-2) var(--s-1) 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--s-2);
}
.greeting-left {
  flex: 1;
  min-width: 0;
}
.greeting-hello {
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.04em;
  display: block;
  margin-bottom: var(--s-2);
}
.greeting-summary {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--s-1);
}
.summary-text {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  letter-spacing: 0.04em;
}
.summary-num {
  font-family: var(--font-num);
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--amber);
  font-variant-numeric: tabular-nums;
}

.settings-link {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-sm);
  margin-top: 4rpx;
}
.settings-link.press { background: var(--paper-3); opacity: 0.85; }
.settings-link-glyph {
  font-size: 30rpx;
  color: var(--ink-2);
}
.greeting-actions {
  display: flex;
  gap: var(--s-1);
  margin-top: 4rpx;
}

/* —— 月份选择条 —— */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-2) var(--s-3);
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-sm);
}
.month-arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.15s ease, opacity 0.15s ease;
}
.month-arrow.press { background: var(--paper-3); opacity: 0.85; }
.arrow-glyph {
  font-family: var(--font-serif);
  font-size: 36rpx;
  color: var(--amber);
  line-height: 1;
  font-weight: 500;
}
.month-display {
  display: flex;
  align-items: center;
}
.month-name {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.08em;
}

/* —— 房间列表 —— */
.cards {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  margin-top: var(--s-1);
}
