.container {
  padding: var(--s-4) var(--s-3) var(--s-6);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
}

/* —— 问候区 —— */
.greeting {
  padding: var(--s-2) var(--s-1) 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--s-2);
}
.greeting-left {
  flex: 1;
  min-width: 0;
}
.greeting-hello {
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.04em;
  display: block;
  margin-bottom: var(--s-2);
}
.greeting-summary {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--s-1);
}
.summary-text {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  letter-spacing: 0.04em;
}
.summary-num {
  font-family: var(--font-num);
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--amber);
  font-variant-numeric: tabular-nums;
}

/* 本月水电用量：水/电配色与历史页趋势图一致 */
.greeting-usage {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--s-1);
}
.usage-label,
.usage-item {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  letter-spacing: 0.04em;
}
.usage-num {
  font-family: var(--font-num);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.usage-water { color: #4A8FB8; }
.usage-elec { color: #E5854A; }

.settings-link {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-sm);
}
.settings-link.press { background: var(--paper-3); opacity: 0.85; }
.settings-link-glyph {
  font-size: 30rpx;
  color: var(--ink-2);
}
.greeting-actions {
  display: flex;
  gap: var(--s-1);
  margin-top: 4rpx;
}

/* —— 月份选择条 —— */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-2) var(--s-3);
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-sm);
}
.month-arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.15s ease, opacity 0.15s ease;
}
.month-arrow.disabled .arrow-glyph { color: var(--ink-3); opacity: 0.35; }
.month-arrow.press { background: var(--paper-3); opacity: 0.85; }
.arrow-glyph {
  font-family: var(--font-serif);
  font-size: 36rpx;
  color: var(--amber);
  line-height: 1;
  font-weight: 500;
}
.month-display {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: var(--s-1) var(--s-2);
  border-radius: var(--r-md);
  transition: background 0.15s ease;
}
.month-display.press { background: var(--paper-3); }
.month-name {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.08em;
}
.month-hint {
  font-size: 22rpx;
  color: var(--amber);
  line-height: 1;
}

/* —— 房间列表 —— */
.cards {
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
  margin-top: var(--s-1);
}

/* —— 加载态 —— */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--s-8) 0;
  gap: var(--s-3);
}
.loading-dots {
  display: flex;
  gap: 12rpx;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--amber);
  animation: dot-bounce 1s ease-in-out infinite;
}
.dot-2 { animation-delay: 0.15s; }
.dot-3 { animation-delay: 0.3s; }
@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.35; }
  40% { transform: scale(1); opacity: 1; }
}
.loading-text {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  letter-spacing: 0.06em;
}
