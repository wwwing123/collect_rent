<view class="container">
  <!-- 房号头 -->
  <view class="room-card">
    <view class="room-info">
      <text class="room-eyebrow">账单历史</text>
      <text class="room-label">{{ roomLabel }}</text>
    </view>
  </view>

  <!-- 表格 -->
  <view class="table">
    <view class="tr th">
      <text class="td col-month">月份</text>
      <text class="td">租金</text>
      <text class="td">水</text>
      <text class="td">电</text>
      <text class="td">其他</text>
      <text class="td col-total">合计</text>
    </view>
    <view wx:for="{{ history }}" wx:key="year_month"
      class="tr {{ item.vacancy ? 'tr-vacancy' : '' }}"
      hover-class="tr-hover"
      data-yearmonth="{{ item.year_month }}"
      bindtap="onTapRow"
    >
      <text class="td col-month">{{ item.year_month }}<text wx:if="{{ item.vacancy }}" class="vacancy-tag">空置</text></text>
      <text class="td tabular">{{ item.rent }}</text>
      <text class="td tabular">{{ item.water_fee }}</text>
      <text class="td tabular">{{ item.elec_fee }}</text>
      <text class="td tabular">{{ item.other }}</text>
      <text class="td col-total tabular">{{ item.total }}</text>
    </view>
  </view>

  <view class="section-title">
    <view class="section-bar"></view>
    <text>水 · 电 用量趋势</text>
  </view>
  <view class="chart-card">
    <view class="chart-head">
      <view class="chart-stats">
        <view class="stat">
          <view class="stat-head">
            <view class="stat-dot stat-dot-water"></view>
            <text class="stat-label">水 · 最近一期</text>
          </view>
          <view class="stat-val">
            <text class="stat-num tabular">{{ latestWater }}</text>
            <text class="stat-unit"> 吨</text>
          </view>
          <text wx:if="{{ latestYM }}" class="stat-ym">{{ latestYM }}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat">
          <view class="stat-head">
            <view class="stat-dot stat-dot-elec"></view>
            <text class="stat-label">电 · 最近一期</text>
          </view>
          <view class="stat-val">
            <text class="stat-num tabular">{{ latestElec }}</text>
            <text class="stat-unit"> 度</text>
          </view>
          <text wx:if="{{ latestYM }}" class="stat-ym">{{ latestYM }}</text>
        </view>
      </view>
    </view>
    <view class="chart-canvas">
      <ec-canvas id="history-chart" canvas-id="history-chart" ec="{{ ec }}"></ec-canvas>
    </view>
  </view>

  <view class="footer">
    <view class="sync-btn" bindtap="onSync" hover-class="press">
      <text class="sync-label">↻ 同步数据</text>
    </view>
  </view>
</view>
