.wrap {
  padding: var(--s-8) var(--s-4) var(--s-6);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: var(--s-4);
}

/* —— Hero —— */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s-3);
  margin-bottom: var(--s-4);
  text-align: center;
}
.logo {
  width: 128rpx;
  height: 128rpx;
  background: var(--amber-tint);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(234, 123, 58, 0.18);
  animation: rise 600ms cubic-bezier(.2,.7,.2,1) 200ms both;
}
.logo-glyph {
  font-family: var(--font-serif);
  font-size: 64rpx;
  font-weight: 600;
  color: var(--amber);
  line-height: 1;
}
.title {
  font-family: var(--font-serif);
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.08em;
}
.tip {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  line-height: 1.7;
  letter-spacing: 0.04em;
  max-width: 80%;
}

/* —— 输入卡 —— */
.field-card {
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: var(--s-3);
  box-shadow: var(--shadow-sm);
}
.field-label {
  display: flex;
  align-items: center;
  gap: var(--s-1);
  font-size: var(--fs-xs);
  color: var(--ink-2);
  letter-spacing: 0.16em;
  font-weight: 600;
  margin-bottom: var(--s-2);
}
.field-bar {
  width: 6rpx;
  height: 22rpx;
  background: var(--amber);
  border-radius: 2rpx;
}
.field-input {
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  padding: var(--s-2) var(--s-3);
  display: flex;
  align-items: center;
  height: 96rpx;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.field-input:focus-within {
  border-color: var(--amber);
  box-shadow: 0 0 0 4rpx rgba(234, 123, 58, 0.10);
}

/* —— 错误提示 —— */
.err {
  display: flex;
  align-items: center;
  gap: var(--s-1);
  padding: var(--s-2) var(--s-3);
  background: var(--amber-tint);
  border: 1rpx solid rgba(234, 123, 58, 0.28);
  border-radius: var(--r-md);
  color: var(--amber-2);
  font-size: var(--fs-sm);
  letter-spacing: 0.04em;
  animation: rise 280ms cubic-bezier(.2,.7,.2,1) both;
}
.err-dot {
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--amber);
}

/* —— 加入按钮 —— */
.join-btn {
  margin-top: var(--s-2);
  height: 104rpx;
  background: var(--amber);
  color: #FFFFFF;
  border-radius: var(--r-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-amber);
  transition: background 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
}
.join-btn.press {
  background: var(--amber-2);
  box-shadow: 0 2rpx 6rpx rgba(234, 123, 58, 0.22);
  opacity: 0.9;
}
.join-label {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.32em;
  padding-right: 0.32em;
}
